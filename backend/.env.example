PORT=5000
MONGODB_URI=

# MSG91 OTP (https://control.msg91.com)
# OTP send/verify always goes through MSG91 — there is no “accept any code” bypass.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5
# Optional: relaxes Aadhaar Verhoeff checks in local KYC testing only (does NOT bypass OTP)
MSG91_DEBUG=false
MSG91_USE_SENDER=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=

# TruDetails CIBIL (https://trudetails.com/enrich/v2/get-cibil-report)
API_KEY=
# Optional alias for API_KEY
TRUDETAILS_API_KEY=
# Public HTTPS origin of this backend (used to build Callback_Url)
PUBLIC_BASE_URL=https://api.sakaarfoundation.org
# Optional full callback override
# CIBIL_CALLBACK_URL=https://api.sakaarfoundation.org/api/cibil/callback
